<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>COMPEL</RootNamespace>
        <AssemblyName>COMPEL</AssemblyName>

        <!-- Native AOT Compatibility: Bind Configuration And Generate Request Delegates Via Source Generators Rather Than Reflection. -->
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
        <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>

        <!-- Reduces The Published Size And Avoids Loading Culture Data That Native AOT Cannot Trim Cleanly; The Code Uses Invariant String Operations Throughout. -->
        <InvariantGlobalization>true</InvariantGlobalization>

        <!-- COMPEL Serves Only JSON Endpoints, So Static Web Assets Are Disabled To Keep Them (And The "staticwebassets.endpoints.json" Manifest) Out Of The Published Output. -->
        <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>

        <ApplicationIcon>Assets\compel.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="Assets\compel.ico" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    </ItemGroup>

    <!-- Generates A Version String Constant From The Project's Version. -->
    <Target Name="GenerateVersionSource" BeforeTargets="CoreCompile" DependsOnTargets="PrepareForBuild">
        <PropertyGroup>
            <_GeneratedVersionFile>$(IntermediateOutputPath)GeneratedVersionInformation.g.cs</_GeneratedVersionFile>
        </PropertyGroup>
        <WriteLinesToFile File="$(_GeneratedVersionFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
            Lines="namespace COMPEL%3B internal static class GeneratedVersionInformation { internal const string VersionString = &quot;$(Version)&quot;%3B }" />
        <ItemGroup>
            <Compile Include="$(_GeneratedVersionFile)" />
        </ItemGroup>
    </Target>

</Project>
